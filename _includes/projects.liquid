<div class="col">
  <div class="card h-100 hoverable">
    {% if project.redirect %}
      {% assign proj_url = project.redirect %}
    {% else %}
      {% assign proj_url = project.url | relative_url %}
    {% endif %}
    {% if project.img %}
      <a href="{{ proj_url }}" class="card-media-link" tabindex="-1">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      </a>
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">
        <a href="{{ proj_url }}" class="card-title-link">{{ project.title }}</a>
        {% if project.github %}
          {% if project.github contains '://' %}
            {% assign gh_url = project.github %}
          {% else %}
            {% assign gh_url = project.github | prepend: 'https://github.com/' %}
          {% endif %}
          <a class="title-gh-icon" href="{{ gh_url }}" aria-label="{{ project.title }} code repository" title="Code repository" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-github"></i>
          </a>
        {% endif %}
      </h2>
      <a href="{{ proj_url }}" class="card-text-link">
        <p class="card-text">{{ project.description }}</p>
      </a>
    </div>
  </div>
</div>
