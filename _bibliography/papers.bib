@unpublished{gondi2026sed,
  abbr        = {ARR},
  title       = {Self-Evolving Defense: Continual Security Policy Learning for LLM Agents},
  author      = {Le, Minh Nhat and Gondi, Nisarga and Peng, Yibo and Ni, Ronghao and Jia, Limin and Chen, Beidi and Zheng, Haizhong},
  year        = {2026},
  note        = {Under review, ACL Rolling Review},
  arxiv       = {2609.36603},
  code        = {https://github.com/Infini-AI-Lab/SED},
  website     = {https://github.com/Infini-AI-Lab/SED},
  preview     = {sed_adaptive_asr.png},
  selected    = {true},
  bibtex_show = {true},
  abstract    = {LLM agents increasingly read untrusted content, call external tools, and modify software repositories, which exposes them to jailbreaks, prompt injection, and insecure code generation. We present Self-Evolving Defense (SED), a training-free framework that distills harmful agent trajectories into reusable security policies and retrieves the relevant ones for later tasks, so a frozen agent keeps adapting without any weight update.}
}

